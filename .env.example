# Mixar Local Development Configuration
# Copy this file to .env and modify as needed.
# .env is gitignored and will not be committed.

# Environment: Prod | Dev | UAT
MIXAR_ENV=Prod

# Backend API URL for this environment
MIXAR_BACKEND_URL=https://api.mixar.app

# Frontend URL for this environment (used for SSO login pages)
MIXAR_FRONTEND_URL=https://www.mixar.app

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MIXAR_LOG_LEVEL=INFO

# --- custom endpoints (runtime overridable, see docs/CUSTOM_ENDPOINTS.md) ---
# These are read at *runtime*, so they override whatever was baked into the
# build. Leave them unset to use the built-in values.
# MIXAR_BACKEND_URL=http://localhost:8000
# MIXAR_FRONTEND_URL=http://localhost:3000
# MIXAR_WS_URL=ws://localhost:8000
# Allow plain http:// on public hosts (localhost/LAN never needs this)
# MIXAR_ALLOW_INSECURE_ENDPOINTS=0
# HTTP client tuning
# MIXAR_HTTP_CONNECT_TIMEOUT=5
# MIXAR_HTTP_READ_TIMEOUT=30
# MIXAR_HTTP_RETRIES=3
# MIXAR_HTTP_BACKOFF=0.3
# MIXAR_HTTP_POOL_MAXSIZE=32

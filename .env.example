# Mixar Local Development Configuration
# Copy this file to .env and modify as needed.
# .env is gitignored and will not be committed.

# Environment: Prod | Dev | UAT
MIXAR_ENV=Prod

# Backend API URL for this environment
MIXAR_BACKEND_URL=https://api.mixar.app

# Frontend URL for this environment (used for SSO login pages)
MIXAR_FRONTEND_URL=https://www.mixar.app

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MIXAR_LOG_LEVEL=INFO

# --- provider endpoint, fork addition (see docs/CUSTOM_BASE_URL.md) ---
# Only the AI *provider* endpoint is overridable in this fork. The Mixar
# backend above is left alone: it stays whatever the build shipped.
# Send agent provider requests to an OpenAI-compatible endpoint of your own:
# MIXAR_BYOK_BASE_URL=http://localhost:11434/v1
# Allow plain http:// to a public host (localhost and LAN never need this):
# MIXAR_ALLOW_INSECURE_ENDPOINTS=0
# Where that setting is stored (defaults to Blender's user config directory):
# MIXAR_USER_CONFIG_DIR=
